---
/**
 * The Lab shows only what exists today (Brand Guidelines, 10 · Lab status tags).
 * bento: home page preview. rows: the Lab page, with a status filter.
 */
import Icon from './Icon.astro';
import StatusTag from './StatusTag.astro';
import { getCopy, path, type Lang } from '../i18n';
import { site } from '../data/site';

interface Props {
  lang: Lang;
  layout?: 'bento' | 'rows';
}
const { lang, layout = 'bento' } = Astro.props;
const t = getCopy(lang);
const now = t.lab.now;
type Status = 'testing' | 'live' | 'venture';

const items = now.items.map((item) => {
  const status = item.status as Status;
  let href = '';
  let external = false;
  if (item.key === 'astia') {
    href = site.astiaUrl;
    external = true;
  } else if (item.key === 'brand-sites') {
    href = path(lang, 'ai');
  }
  return { ...item, status, href, external };
});
const statuses: Status[] = ['testing', 'live', 'venture'];
const counts = Object.fromEntries(statuses.map((s) => [s, items.filter((i) => i.status === s).length]));
---

{
  layout === 'bento' ? (
    <ul class="lab-bento" role="list">
      {items.map((item, i) => (
        <li
          class:list={['lab-card', i === 0 ? 'panel-dark lab-card--feature' : i === 1 ? 'card' : 'panel']}
          data-reveal
          style={`--i:${i}`}
        >
          <StatusTag status={item.status} lang={lang} />
          <h3 class={i === 0 ? 'h1' : 'h2'}>{item.name}</h3>
          <p class="lab-card__text">{item.text}</p>
          {item.endorsement && <p class="label label--quiet">{item.endorsement}</p>}
          {item.href && (
            <a
              href={item.href}
              class:list={['arrow-link', { 'arrow-link--out': item.external }]}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener' : undefined}
            >
              {item.link}
              <Icon name={item.external ? 'arrow-up-right' : 'arrow-right'} />
              {item.external && <span class="visually-hidden">{t.ui.newTab}</span>}
            </a>
          )}
        </li>
      ))}
    </ul>
  ) : (
    <div class="lab-rows" data-lab-filter>
      <div class="lab-filter" role="group" aria-label={now.filterLabel}>
        <button type="button" aria-pressed="true" data-filter="all">
          {now.all} <span class="lab-filter__count">{items.length}</span>
        </button>
        {statuses.map((s) => (
          <button type="button" aria-pressed="false" data-filter={s}>
            {t.status[s]} <span class="lab-filter__count">{counts[s]}</span>
          </button>
        ))}
      </div>
      <dl class="lab-legend">
        {statuses.map((s) => (
          <div>
            <dt>
              <StatusTag status={s} lang={lang} />
            </dt>
            <dd>{now.legend[s]}</dd>
          </div>
        ))}
      </dl>
      <ul class="lab-list" role="list" aria-live="polite">
        {items.map((item, i) => (
          <li class="lab-row" data-status={item.status} data-reveal style={`--i:${i}`}>
            <div class="lab-row__tag">
              <StatusTag status={item.status} lang={lang} />
            </div>
            <div class="lab-row__body">
              <h3 class="h1">{item.name}</h3>
              <p class="body muted">{item.text}</p>
              {item.endorsement && <p class="label label--quiet">{item.endorsement}</p>}
            </div>
            <div class="lab-row__link">
              {item.href && (
                <a
                  href={item.href}
                  class:list={['arrow-link', { 'arrow-link--out': item.external }]}
                  target={item.external ? '_blank' : undefined}
                  rel={item.external ? 'noopener' : undefined}
                >
                  {item.link}
                  <Icon name={item.external ? 'arrow-up-right' : 'arrow-right'} />
                  {item.external && <span class="visually-hidden">{t.ui.newTab}</span>}
                </a>
              )}
            </div>
          </li>
        ))}
      </ul>
      <p class="lab-empty body muted" hidden data-lab-empty>
        {now.empty}
      </p>
    </div>
  )
}

<style>
  /* ---------- Bento (home) ---------- */
  .lab-bento {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: auto;
    gap: var(--gutter);
  }
  .lab-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    padding: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    grid-column: 8 / span 5;
    transition: transform 0.5s var(--ease-out);
  }
  .lab-card--feature {
    grid-column: 1 / span 7;
    grid-row: span 2;
    justify-content: flex-end;
    min-height: 26rem;
  }
  .lab-card__text {
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--fg-muted);
    max-width: 34em;
  }
  .lab-card--feature .lab-card__text {
    font-size: var(--t-body);
  }
  .lab-card .arrow-link {
    margin-top: auto;
  }
  .lab-card--feature .arrow-link {
    margin-top: 0.5rem;
  }
  @media (max-width: 900px) {
    .lab-card,
    .lab-card--feature {
      grid-column: 1 / -1;
      grid-row: auto;
      min-height: 0;
    }
    .lab-card--feature {
      min-height: 20rem;
    }
  }

  /* ---------- Rows (Lab page) ---------- */
  .lab-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .lab-filter button {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 40px;
    padding: 0.45rem 0.95rem;
    font-family: var(--sans);
    font-size: var(--t-small);
    font-weight: 500;
    background: transparent;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    cursor: pointer;
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }
  .lab-filter button:hover {
    border-color: var(--fg);
  }
  .lab-filter button[aria-pressed='true'] {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }
  .lab-filter__count {
    font-family: var(--mono);
    font-size: 0.6875rem;
    opacity: 0.7;
  }
  .lab-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    margin: 1.5rem 0 2.5rem;
  }
  .lab-legend > div {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .lab-legend dd {
    margin: 0;
    font-family: var(--sans);
    font-size: var(--t-small);
    color: var(--fg-muted);
  }
  .lab-list {
    border-top: 2px solid var(--rule);
  }
  .lab-row {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: 1rem;
    padding-block: clamp(1.75rem, 1.25rem + 1.5vw, 2.75rem);
    border-bottom: 1px solid var(--hairline);
  }
  .lab-row[hidden] {
    display: none;
  }
  .lab-row__tag {
    grid-column: 1 / span 2;
    padding-top: 0.6rem;
  }
  .lab-row__body {
    grid-column: 3 / span 7;
    display: grid;
    gap: 0.85rem;
  }
  .lab-row__link {
    grid-column: 10 / span 3;
    justify-self: end;
    padding-top: 0.35rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .lab-row.is-filtered-in {
      animation: fade-up 0.5s var(--ease-out) both;
    }
  }
  .lab-empty {
    padding-block: 2rem;
  }
  @media (max-width: 800px) {
    .lab-row__tag,
    .lab-row__body,
    .lab-row__link {
      grid-column: 1 / -1;
      justify-self: start;
      padding-top: 0;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-lab-filter]').forEach((root) => {
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const rows = Array.from(root.querySelectorAll<HTMLElement>('[data-status]'));
    const empty = root.querySelector<HTMLElement>('[data-lab-empty]');
    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        const f = btn.dataset.filter;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        let shown = 0;
        rows.forEach((row) => {
          const show = f === 'all' || row.dataset.status === f;
          row.hidden = !show;
          row.classList.remove('is-filtered-in');
          if (show) {
            shown++;
            row.classList.add('is-in');
            void row.offsetWidth;
            row.classList.add('is-filtered-in');
          }
        });
        if (empty) empty.hidden = shown > 0;
      }),
    );
  });
</script>
