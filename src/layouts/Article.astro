---
/**
 * Essays and Field Notes. English only. Long-form text is set in Newsreader
 * for a calm, readable page (09 · Typography, Body).
 */
import { Image } from 'astro:assets';
import portrait from '../assets/marco-rosso.png';
import Base from './Base.astro';
import Icon from '../components/Icon.astro';
import NoteList, { type NoteRow } from '../components/NoteList.astro';
import StatusTag from '../components/StatusTag.astro';
import { getCopy, path, formatDate } from '../i18n';
import { site } from '../data/site';
import { smartQuotes } from '../lib/typography';

interface Props {
  title: string;
  deck: string;
  date: Date;
  kicker: string;
  readTime?: number;
  status?: 'testing' | 'live' | 'venture' | 'closed';
  seoTitle?: string;
  seoDescription?: string;
  image?: string;
  related?: NoteRow[];
}

const { title, deck, date, kicker, readTime, status, seoTitle, seoDescription, image, related = [] } = Astro.props;
const lang = 'en' as const;
const t = getCopy(lang);
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const articleLd = {
  '@type': 'Article',
  headline: title,
  description: seoDescription ?? deck,
  datePublished: date.toISOString(),
  inLanguage: 'en',
  mainEntityOfPage: canonical,
  author: { '@id': `${site.url}/#marco-rosso` },
  publisher: { '@id': `${site.url}/#rosso-consulting` },
  image: new URL(image ?? '/og-default.png', Astro.site).toString(),
};
---

<Base
  lang={lang}
  title={seoTitle ?? `${smartQuotes(title)} · Marco Rosso`}
  description={seoDescription ?? smartQuotes(deck)}
  current="notes"
  translated={false}
  type="article"
  image={image}
  published={date}
  jsonLd={[articleLd]}
>
  <div class="reading-progress" aria-hidden="true"></div>
  <article class="article">
    <header class="container article__head">
      <a href={path(lang, 'notes')} class="arrow-link article__back">
        <Icon name="arrow-left" />
        {t.article.back}
      </a>
      <p class="label article__meta">
        <span>{kicker}</span>
        <span aria-hidden="true">·</span>
        <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date, lang)}</time>
        {
          readTime && (
            <>
              <span aria-hidden="true">·</span>
              <span>
                {readTime} {t.ui.minRead}
              </span>
            </>
          )
        }
      </p>
      {status && <StatusTag status={status} lang={lang} />}
      <h1 class="article__title">{smartQuotes(title)}</h1>
      <p class="standfirst article__deck">{smartQuotes(deck)}</p>
    </header>

    <div class="container article__body">
      <div class="prose">
        <slot />
      </div>
    </div>

    <footer class="container article__foot">
      <div class="author card">
        <Image src={portrait} alt="" width={64} height={64} densities={[1, 2, 3]} class="author__img" />
        <div class="author__copy">
          <p class="label label--quiet">{t.article.authorTitle}</p>
          <p class="author__bio">{t.article.authorBio}</p>
          <div class="author__actions">
            <a href={path(lang, 'contact')} class="btn btn--marker">{t.ui.cta}<Icon name="arrow-right" /></a>
            <a href={site.linkedin} class="arrow-link arrow-link--out" target="_blank" rel="me noopener">
              LinkedIn <Icon name="arrow-up-right" /><span class="visually-hidden">{t.ui.newTab}</span>
            </a>
          </div>
        </div>
      </div>
    </footer>
  </article>

  {
    related.length > 0 && (
      <section class="section related" aria-labelledby="related-title">
        <div class="container">
          <h2 id="related-title" class="h1 related__title">
            {t.article.related}
          </h2>
          <NoteList rows={related} lang={lang} />
        </div>
      </section>
    )
  }
</Base>

<style>
  /* Reading progress: a thin Rosso Scuro line under the header, driven by
     the scroll position in CSS. Hidden where scroll timelines are unsupported. */
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    z-index: 60;
    background: var(--rosso-scuro);
    transform-origin: left center;
    transform: scaleX(0);
    display: none;
  }
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .reading-progress {
        display: block;
        animation: progress linear both;
        animation-timeline: scroll(root block);
      }
    }
  }
  @keyframes progress {
    to {
      transform: scaleX(1);
    }
  }

  .article__head {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
    padding-top: clamp(2rem, 1.5rem + 2.5vw, 4rem);
    padding-bottom: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    max-width: calc(46rem + 2 * var(--side));
    width: min(46rem, 100% - 2 * var(--side));
  }
  .article__back {
    margin-bottom: 1rem;
  }
  .article__back:hover :global(svg) {
    transform: translateX(-4px);
  }
  .article__meta {
    flex-wrap: wrap;
    gap: 0.6em;
  }
  .article__title {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(2.25rem, 1.6rem + 2.6vw, 3.5rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .article__deck {
    color: var(--fg-muted);
  }
  .article__body {
    width: min(46rem, 100% - 2 * var(--side));
    padding-top: 2rem;
    border-top: 2px solid var(--rule);
  }
  .article__body .prose {
    max-width: none;
  }
  .article__body .prose > :global(p:first-child) {
    font-size: 1.25em;
    line-height: 1.5;
    font-weight: 300;
  }

  .article__foot {
    width: min(46rem, 100% - 2 * var(--side));
    padding-top: clamp(3rem, 2rem + 3vw, 5rem);
  }
  .author {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 1.25rem;
    padding: clamp(1.25rem, 1rem + 1.5vw, 2rem);
  }
  .author :global(.author__img) {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--sabbia);
  }
  .author__copy {
    display: grid;
    gap: 0.75rem;
  }
  .author__bio {
    font-size: 1.0625rem;
    line-height: 1.55;
  }
  .author__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 0.5rem;
  }
  @media (max-width: 560px) {
    .author {
      grid-template-columns: 1fr;
    }
  }

  .related__title {
    margin-bottom: 2rem;
  }
</style>
