---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';
import newsreaderLatin from '@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { getCopy, langs, switchLang, type Lang, type RouteKey } from '../i18n';
import { buildGraph, type Crumb, type PageType } from '../lib/schema';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  current?: RouteKey;
  /** false for English-only pages (essays, Field Notes) */
  translated?: boolean;
  type?: 'website' | 'article';
  image?: string;
  /** Alt text for a custom social image */
  imageAlt?: string;
  published?: Date;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  /** schema.org page type; derived from `current` when omitted */
  pageType?: PageType;
  /** breadcrumb trail after Home; derived from `current` when omitted */
  crumbs?: Crumb[];
}

const {
  lang,
  title,
  description,
  current,
  translated = true,
  type = 'website',
  image = '/og-default.png',
  imageAlt,
  published,
  noindex = false,
  jsonLd = [],
  pageType,
  crumbs,
} = Astro.props;

// Google Analytics 4, only after consent (components/ConsentBanner.astro) and only on the
// production site. Netlify sets CONTEXT at build time ('production', 'deploy-preview',
// 'branch-deploy', 'dev'); elsewhere the banner still shows, but Accept loads nothing.
const GA_ID = 'G-0F79ZV4NLT';
const gaEnabled = process.env.CONTEXT === 'production';
// Runs before first paint. Nothing is requested from Google unless the visitor has
// stored rc-consent = granted (version 1). loadGA() is also what Accept calls.
const consentInit = `(function(){var ID=${JSON.stringify(gaEnabled ? GA_ID : null)},KEY='rc-consent',V=1;function read(){try{var c=JSON.parse(localStorage.getItem(KEY)||'null');return c&&c.v===V&&(c.value==='granted'||c.value==='denied')?c.value:null}catch(e){return null}}var api={key:KEY,version:V,gaId:ID,loaded:false,read:read,loadGA:function(){if(!ID||api.loaded)return;api.loaded=true;window.dataLayer=window.dataLayer||[];window.gtag=function(){dataLayer.push(arguments);};gtag('js',new Date());gtag('config',ID);var s=document.createElement('script');s.async=true;s.src='https://www.googletagmanager.com/gtag/js?id='+ID;document.head.appendChild(s);}};window.__rcConsent=api;if(read()==='granted')api.loadGA();})();`;

const t = getCopy(lang);
const pathname = Astro.url.pathname;
const canonical = new URL(pathname, Astro.site).toString();
const ogImage = new URL(image, Astro.site).toString();
const isDefaultImage = image === '/og-default.png';
// The brand tagline describes only the default card; a custom image falls back to the page title.
const ogImageAlt = isDefaultImage ? 'Rosso Consulting · Tried before advised.' : (imageAlt ?? title);
const alternates = translated
  ? langs.map((l) => ({ lang: l, href: new URL(switchLang(pathname, l), Astro.site).toString() }))
  : [{ lang: 'en' as Lang, href: canonical }];
const xDefault = translated ? new URL(switchLang(pathname, 'en'), Astro.site).toString() : canonical;

const pageLabels: Partial<Record<RouteKey, string>> = {
  advisory: t.ui.nav.advisory,
  ai: t.ui.nav.ai,
  lab: t.ui.nav.lab,
  notes: t.ui.nav.notes,
  about: t.ui.nav.about,
  contact: t.contact.hero.label,
  privacy: t.footer.privacy,
};
const homeUrl = new URL(switchLang('/', lang), Astro.site).toString();
const trail: Crumb[] = [
  { name: t.ui.home, url: homeUrl },
  ...(crumbs ?? (current && pageLabels[current] ? [{ name: pageLabels[current]!, url: canonical }] : [])),
];
const resolvedType: PageType =
  pageType ??
  (current === 'about' ? 'ProfilePage' : current === 'contact' ? 'ContactPage' : current === 'notes' ? 'CollectionPage' : 'WebPage');
const graph = buildGraph({ lang, url: canonical, title, description, pageType: resolvedType, crumbs: trail, extra: jsonLd });
const ld = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');

/* Set before first paint: theme (stored choice or system), the js class for
   progressive reveals, and a safety net that shows content if scripts fail. */
const themeInit = `(function(){var d=document.documentElement;d.classList.add('js');var s=null;try{s=localStorage.getItem('rc-theme')}catch(e){}if(s==='dark'||s==='light')d.setAttribute('data-theme',s);var m=window.matchMedia('(prefers-color-scheme: dark)');window.__rcResolveTheme=function(){d.setAttribute('data-theme-resolved',d.getAttribute('data-theme')||(m.matches?'dark':'light'))};window.__rcResolveTheme();if(m.addEventListener)m.addEventListener('change',window.__rcResolveTheme);setTimeout(function(){if(!window.__rcReady)d.classList.add('no-reveal')},2500)})();`;
---

<!doctype html>
<html lang={t.meta.htmlLang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <script is:inline set:html={consentInit} />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Marco Rosso" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large" />}
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />

    <meta name="theme-color" content="#F6F3EE" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#2C2C2B" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Rosso Consulting · Notes" href="/rss.xml" />
    <link rel="alternate" type="text/plain" title="LLM summary" href="/llms.txt" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={newsreaderLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Rosso Consulting" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {isDefaultImage && <meta property="og:image:width" content="1200" />}
    {isDefaultImage && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={t.meta.ogLocale} />
    {
      translated &&
        langs
          .filter((l) => l !== lang)
          .map((l) => <meta property="og:locale:alternate" content={getCopy(l).meta.ogLocale} />)
    }
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {published && <meta property="article:author" content="Marco Rosso" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script is:inline set:html={themeInit} />
    <script type="application/ld+json" set:html={ld} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.ui.skip}</a>
    <div data-top-sentinel aria-hidden="true" class="top-sentinel"></div>
    <Header lang={lang} current={current} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <ConsentBanner lang={lang} />
  </body>
</html>

<style is:global>
  .top-sentinel {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 24px;
    pointer-events: none;
  }
  main:focus {
    outline: none;
  }
  .icon {
    width: 1em;
    height: 1em;
    flex: none;
  }
  .no-reveal [data-reveal] {
    opacity: 1 !important;
    transform: none !important;
  }
</style>

<script>
  import '../scripts/site';
</script>
