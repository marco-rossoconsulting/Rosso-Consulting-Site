---
import { Image } from 'astro:assets';
import portrait from '../../assets/marco-rosso.png';
import Base from '../../layouts/Base.astro';
import CtaPanel from '../../components/CtaPanel.astro';
import Icon from '../../components/Icon.astro';
import { getCopy, em, langStaticPaths, type Lang } from '../../i18n';

export const getStaticPaths = langStaticPaths;
const { lang } = Astro.props as { lang: Lang };
const t = getCopy(lang);
const a = t.about;
---

<Base lang={lang} title={a.seo.title} description={a.seo.description} current="about">
  <section class="page-hero" aria-labelledby="page-title">
    <div class="container page-hero__inner">
      <div class="page-hero__main">
        <p class="label fade-up" style="--i:0">{a.hero.label}</p>
        <h1 id="page-title" class="display">
          <span class="mask-line" style="--i:0"><span set:html={em(a.hero.title)} /></span>
        </h1>
        <p class="standfirst fade-up" style="--i:1">{a.hero.standfirst}</p>
      </div>
      <figure class="page-hero__aside portrait fade-up" style="--i:2">
        <div class="portrait__frame panel">
          <Image
            src={portrait}
            alt={a.hero.portraitAlt}
            width={200}
            height={200}
            densities={[1, 1.5]}
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <figcaption class="label label--quiet">Marco Rosso · Lugano</figcaption>
      </figure>
    </div>
  </section>

  <section class="section section--flush-top">
    <div class="container">
      <div class="story">
        {
          a.story.map((p, i) => (
            <p class:list={['story__p', { 'story__p--lead': i === 0 }]} data-reveal>
              {p}
            </p>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--flush-top" aria-labelledby="path-title">
    <div class="container">
      <div class="section-head">
        <p class="label" data-reveal>{a.path.label}</p>
        <h2 id="path-title" class="h1" data-reveal style="--i:1" set:html={em(a.path.title)} />
      </div>
      <div class="timeline">
        <span class="timeline__line" data-reveal="rule" aria-hidden="true"></span>
        <ol class="timeline__list" role="list">
          {
            a.path.items.map((item, i) => (
              <li class:list={['timeline__item', { 'timeline__item--now': i === a.path.items.length - 1 }]} data-reveal style={`--i:${i + 1}`}>
                <span class="timeline__node" aria-hidden="true" />
                <span class="label label--quiet">{item.stage}</span>
                <h3 class="h2">{item.title}</h3>
                <p class="timeline__text">{item.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="section section--flush-top">
    <div class="container">
      <ul class="numbers" role="list">
        {
          a.numbers.map((n, i) => (
            <li class="numbers__item rule-heavy" data-reveal style={`--i:${i}`}>
              <p class="numbers__value">
                <span data-count={n.value}>{n.value}</span>{n.suffix}
              </p>
              <p class="numbers__text">{n.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--flush-top" aria-labelledby="career-title">
    <div class="container cv">
      <div class="cv__col">
        <h2 id="career-title" class="h1" data-reveal>{a.career.title}</h2>
        <ol class="cv__list" role="list">
          {
            a.career.items.map((c, i) => (
              <li data-reveal style={`--i:${i}`}>
                <span class="cv__years">{c.years}</span>
                <span class="cv__org">{c.org}</span>
                <span class="cv__role">{c.role}</span>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="cv__col">
        <h2 class="h1" data-reveal>{a.education.title}</h2>
        <ol class="cv__list" role="list">
          {
            a.education.items.map((e, i) => (
              <li data-reveal style={`--i:${i}`}>
                <span class="cv__years">{e.years}</span>
                <span class="cv__org">{e.org}</span>
                <span class="cv__role">{e.what}</span>
              </li>
            ))
          }
        </ol>
        <div class="cv__also panel" data-reveal>
          <h3 class="label label--ink">{a.career.alsoTitle}</h3>
          <ul role="list">
            {a.career.also.map((x) => <li>{x}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--flush-top" aria-labelledby="principles-title">
    <div class="container">
      <div class="section-head">
        <p class="label" data-reveal>{a.principles.label}</p>
        <h2 id="principles-title" class="h1" data-reveal style="--i:1" set:html={em(a.principles.title)} />
      </div>
      <ol class="principles" role="list">
        {
          a.principles.items.map((p, i) => (
            <li data-reveal style={`--i:${i % 2}`}>
              <span class="principles__num">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="h3">{p.name}</h3>
                <p class="principles__text">{p.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--flush-top" id="bios" aria-labelledby="bios-title">
    <div class="container bios" data-bios>
      <div class="bios__head">
        <h2 id="bios-title" class="h1" data-reveal set:html={em(a.bios.title)} />
        <p class="body muted" data-reveal style="--i:1">{a.bios.intro}</p>
      </div>
      <div class="bios__box card" data-reveal style="--i:1">
        <div class="bios__tabs" role="tablist" aria-label={a.bios.title.replace(/\*/g, '')}>
          {
            a.bios.items.map((b, i) => (
              <button
                type="button"
                role="tab"
                id={`bio-tab-${b.key}`}
                aria-controls={`bio-${b.key}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
              >
                {b.tab}
              </button>
            ))
          }
        </div>
        {
          a.bios.items.map((b, i) => (
            <div class="bios__panel" role="tabpanel" id={`bio-${b.key}`} aria-labelledby={`bio-tab-${b.key}`} hidden={i !== 0}>
              <p class="bios__text">{b.text}</p>
              <button type="button" class="btn btn--ghost bios__copy" data-copy={b.text} data-copied={a.bios.copied}>
                <Icon name="copy" class="bios__icon-copy" />
                <Icon name="check" class="bios__icon-done" />
                <span data-copy-label aria-live="polite">{a.bios.copy}</span>
              </button>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaPanel lang={lang} />
</Base>

<style>
  .portrait {
    display: grid;
    justify-items: end;
    gap: 0.75rem;
  }
  .portrait__frame {
    display: grid;
    place-items: end center;
    width: min(100%, 240px);
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }
  .portrait__frame img {
    width: 200px;
    height: auto;
  }
  @media (max-width: 900px) {
    .portrait {
      justify-items: start;
    }
    .portrait__frame {
      width: 180px;
    }
    .portrait__frame img {
      width: 160px;
    }
  }

  /* Story: an editorial column, the first paragraph set larger */
  .story {
    display: grid;
    gap: 1.25rem;
    max-width: 40rem;
    margin-left: calc(100% / 3);
  }
  @media (max-width: 1000px) {
    .story {
      margin-left: 0;
    }
  }
  .story__p {
    font-size: var(--t-body);
    line-height: 1.65;
    text-wrap: pretty;
  }
  .story__p--lead {
    font-size: clamp(1.375rem, 1.15rem + 0.9vw, 1.75rem);
    font-weight: 300;
    line-height: 1.45;
    letter-spacing: -0.008em;
  }

  /* Timeline */
  .timeline {
    position: relative;
  }
  .timeline__line {
    position: absolute;
    left: 0;
    right: 0;
    top: 10px;
    height: 1px;
    background: var(--fg);
  }
  .timeline__list {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--gutter);
  }
  .timeline__item {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding-top: 2.5rem;
    position: relative;
  }
  .timeline__node {
    position: absolute;
    top: 5px;
    left: 0;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--bg);
    border: 1.5px solid var(--fg);
  }
  .timeline__item--now .timeline__node {
    background: var(--fg);
  }
  .timeline__text {
    font-family: var(--sans);
    font-size: var(--t-small);
    line-height: 1.5;
    color: var(--fg-muted);
  }
  @media (max-width: 900px) {
    .timeline__line {
      left: 5px;
      right: auto;
      top: 0;
      bottom: 0;
      width: 1px;
      height: auto;
      transform-origin: top center;
    }
    :global(.js) .timeline__line[data-reveal='rule'] {
      transform: scaleY(0);
    }
    :global(.js) .timeline__line[data-reveal='rule'].is-in {
      transform: scaleY(1);
    }
    .timeline__list {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-left: 2rem;
    }
    .timeline__item {
      padding-top: 0;
    }
    .timeline__node {
      top: 0.5rem;
      left: -2rem;
    }
  }

  /* Numbers */
  .numbers {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gutter);
  }
  .numbers__item {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding-top: 1.25rem;
  }
  .numbers__value {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(3.5rem, 2.5rem + 4vw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: lining-nums tabular-nums;
  }
  .numbers__text {
    font-family: var(--sans);
    font-size: var(--t-small);
    line-height: 1.5;
    color: var(--fg-muted);
    max-width: 18em;
  }
  @media (max-width: 800px) {
    .numbers {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 2.5rem;
    }
  }

  /* Career and education */
  .cv {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem var(--gutter);
    align-items: start;
  }
  .cv__col {
    display: grid;
    gap: 1.5rem;
  }
  .cv__list {
    border-top: 2px solid var(--rule);
  }
  .cv__list li {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    column-gap: 1rem;
    row-gap: 0.2rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--hairline);
  }
  .cv__years {
    grid-row: span 2;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--fg-muted);
    padding-top: 0.35rem;
  }
  .cv__org {
    font-family: var(--serif);
    font-size: 1.25rem;
    line-height: 1.3;
  }
  .cv__role {
    font-family: var(--sans);
    font-size: var(--t-small);
    line-height: 1.5;
    color: var(--fg-muted);
  }
  .cv__also {
    display: grid;
    gap: 0.75rem;
    padding: 1.25rem 1.5rem;
    margin-top: 0.5rem;
  }
  .cv__also ul {
    display: grid;
    gap: 0.4rem;
    font-family: var(--sans);
    font-size: var(--t-ui);
  }
  @media (max-width: 860px) {
    .cv {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 420px) {
    .cv__list li {
      grid-template-columns: 1fr;
    }
    .cv__years {
      grid-row: auto;
      padding-top: 0;
    }
  }

  /* Principles: ten, in two columns */
  .principles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: calc(var(--gutter) * 2);
    border-top: 2px solid var(--rule);
  }
  .principles li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 0.75rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--hairline);
  }
  .principles li > div {
    display: grid;
    gap: 0.4rem;
  }
  .principles__num {
    font-family: var(--mono);
    font-size: var(--t-label);
    letter-spacing: 0.12em;
    color: var(--label);
    padding-top: 0.45rem;
  }
  .principles__text {
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--fg-muted);
  }
  @media (max-width: 800px) {
    .principles {
      grid-template-columns: 1fr;
    }
  }

  /* Bios */
  .bios {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 2rem var(--gutter);
    align-items: start;
  }
  .bios__head {
    grid-column: 1 / span 4;
    display: grid;
    gap: 1rem;
  }
  .bios__box {
    grid-column: 6 / span 7;
    padding: clamp(1.25rem, 1rem + 1.5vw, 2rem);
  }
  .bios__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding-bottom: 1.25rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--hairline);
  }
  .bios__tabs button {
    min-height: 38px;
    padding: 0.4rem 0.85rem;
    font-family: var(--sans);
    font-size: var(--t-small);
    font-weight: 500;
    background: transparent;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    cursor: pointer;
  }
  .bios__tabs button:hover {
    border-color: var(--fg);
  }
  .bios__tabs button[aria-selected='true'] {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }
  .bios__panel {
    display: grid;
    justify-items: start;
    gap: 1.5rem;
  }
  .bios__panel[hidden] {
    display: none;
  }
  .bios__text {
    font-size: 1.125rem;
    line-height: 1.6;
  }
  .bios__copy :global(.bios__icon-done) {
    display: none;
  }
  .bios__copy.is-copied :global(.bios__icon-done) {
    display: block;
  }
  .bios__copy.is-copied :global(.bios__icon-copy) {
    display: none;
  }
  .bios__copy:hover :global(svg) {
    transform: none;
  }
  @media (max-width: 900px) {
    .bios__head,
    .bios__box {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-bios]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const select = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(tab.getAttribute('aria-controls') || '');
        if (panel) panel.hidden = !on;
      });
      if (focus) tabs[index].focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (e) => {
        const last = tabs.length - 1;
        let next = -1;
        if (e.key === 'ArrowRight') next = i === last ? 0 : i + 1;
        if (e.key === 'ArrowLeft') next = i === 0 ? last : i - 1;
        if (e.key === 'Home') next = 0;
        if (e.key === 'End') next = last;
        if (next >= 0) {
          e.preventDefault();
          select(next, true);
        }
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
      const label = btn.querySelector<HTMLElement>('[data-copy-label]');
      const original = label?.textContent ?? '';
      btn.addEventListener('click', async () => {
        const text = btn.dataset.copy ?? '';
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          // Fallback for browsers without the async clipboard API.
          const area = document.createElement('textarea');
          area.value = text;
          area.setAttribute('readonly', '');
          area.style.position = 'fixed';
          area.style.opacity = '0';
          document.body.appendChild(area);
          area.select();
          document.execCommand('copy');
          area.remove();
        }
        btn.classList.add('is-copied');
        if (label) label.textContent = btn.dataset.copied ?? original;
        setTimeout(() => {
          btn.classList.remove('is-copied');
          if (label) label.textContent = original;
        }, 2000);
      });
    });
  });
</script>
