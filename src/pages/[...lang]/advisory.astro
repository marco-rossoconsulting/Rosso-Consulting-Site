---
import Base from '../../layouts/Base.astro';
import CtaPanel from '../../components/CtaPanel.astro';
import Icon from '../../components/Icon.astro';
import { getCopy, path, em, plain, langStaticPaths, type Lang } from '../../i18n';
import { portfolio } from '../../data/site';

export const getStaticPaths = langStaticPaths;
const { lang } = Astro.props as { lang: Lang };
const t = getCopy(lang);
const a = t.advisory;
const areaStyles = ['card', 'panel', 'card', 'panel-dark'];
---

<Base lang={lang} title={a.seo.title} description={a.seo.description} current="advisory">
  <section class="page-hero" aria-labelledby="page-title">
    <div class="container page-hero__inner">
      <div class="page-hero__main">
        <p class="label fade-up" style="--i:0">{a.hero.label}</p>
        <h1 id="page-title" class="display">
          <span class="mask-line" style="--i:0"><span set:html={em(a.hero.title)} /></span>
        </h1>
        <p class="standfirst fade-up" style="--i:1">{a.hero.standfirst}</p>
        <div class="page-hero__actions fade-up" style="--i:2">
          <a href={path(lang, 'contact')} class="btn btn--marker">{t.ui.cta}<Icon name="arrow-right" /></a>
          <a href="#portfolio" class="arrow-link">{a.hero.secondary}<Icon name="arrow-right" /></a>
        </div>
      </div>
      <div class="page-hero__aside deal fade-up" style="--i:3">
        <h2 id="deal-title" class="label label--quiet">{a.deal.heading}</h2>
        <ol class="deal__list" role="list">
          {
            a.deal.items.map((item, i) => (
              <li class:list={['deal__item', { 'deal__item--now': i === a.deal.items.length - 1 }]}>
                <span class="deal__when">{item.when}</span>
                <span class="deal__line">{item.line}</span>
                <span class="deal__text">{item.text}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="section section--flush-top" aria-labelledby="areas-title">
    <div class="container">
      <div class="section-head">
        <h2 id="areas-title" class="h1" data-reveal set:html={em(a.areas.title)} />
      </div>
      <ul class="areas" role="list">
        {
          a.areas.items.map((item, i) => (
            <li class:list={['area', areaStyles[i], `area--${i}`]} data-reveal style={`--i:${i}`}>
              <span class="area__num label label--quiet">0{i + 1}</span>
              <h3 class="h1">{item.name}</h3>
              <p class="area__text">{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--flush-top" id="portfolio" aria-labelledby="portfolio-title">
    <div class="container">
      <div class="section-head">
        <p class="label" data-reveal>{a.portfolio.label}</p>
        <h2 id="portfolio-title" class="h1" data-reveal style="--i:1" set:html={em(a.portfolio.title)} />
        <p class="body" data-reveal style="--i:2">{a.portfolio.intro}</p>
      </div>
      <div class="pf" role="table" aria-label={plain(a.portfolio.title)}>
        <div class="pf__head" role="row">
          <span role="columnheader">{a.portfolio.cols.company}</span>
          <span role="columnheader">{a.portfolio.cols.category}</span>
          <span role="columnheader">{a.portfolio.cols.role}</span>
          <span role="columnheader">{a.portfolio.cols.focus}</span>
        </div>
        {
          portfolio.map((co, i) => {
            const d = a.portfolio.items[co.id];
            return (
              <div class="pf__row" role="row" data-reveal style={`--i:${i}`}>
                <span class="pf__name" role="cell">
                  <a href={co.url} target="_blank" rel="noopener" class="pf__link">
                    {co.name}
                    <Icon name="arrow-up-right" />
                    <span class="visually-hidden">{t.ui.newTab}</span>
                  </a>
                </span>
                <span class="pf__cell" role="cell" data-label={a.portfolio.cols.category}>
                  {d.category}
                </span>
                <span class="pf__cell pf__role" role="cell" data-label={a.portfolio.cols.role}>
                  {d.role}
                </span>
                <span class="pf__cell" role="cell" data-label={a.portfolio.cols.focus}>
                  {d.focus}
                </span>
              </div>
            );
          })
        }
      </div>
      <p class="pf__note small" data-reveal>{a.portfolio.note}</p>
    </div>
  </section>

  <section class="section section--flush-top" aria-labelledby="formats-title">
    <div class="container">
      <div class="section-head">
        <h2 id="formats-title" class="h1" data-reveal set:html={em(a.formats.title)} />
      </div>
      <ul class="formats" role="list">
        {
          a.formats.items.map((f, i) => (
            <li class="format rule-heavy" data-reveal style={`--i:${i}`}>
              <h3 class="h2">{f.name}</h3>
              <dl>
                <div>
                  <dt class="label label--quiet">{a.formats.shape}</dt>
                  <dd>{f.shape}</dd>
                </div>
                <div>
                  <dt class="label label--quiet">{a.formats.cadence}</dt>
                  <dd>{f.cadence}</dd>
                </div>
              </dl>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--flush-top" aria-labelledby="investors-title">
    <div class="container">
      <div class="investors panel" data-reveal>
        <div class="investors__copy">
          <p class="label label--ink">{a.investors.label}</p>
          <h2 id="investors-title" class="h1" set:html={em(a.investors.title)} />
          <p class="body">{a.investors.body}</p>
        </div>
        <ul class="investors__list" role="list">
          {
            a.investors.items.map((item) => <li>{item}</li>)
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--flush-top" aria-labelledby="independence-title">
    <div class="container independence">
      <div class="independence__head">
        <h2 id="independence-title" class="h1" data-reveal set:html={em(a.independence.title)} />
        <p class="body muted" data-reveal style="--i:1">{a.independence.footnote}</p>
      </div>
      <ol class="independence__list" role="list">
        {
          a.independence.items.map((item, i) => (
            <li data-reveal style={`--i:${i}`}>
              <span class="independence__num">0{i + 1}</span>
              <div>
                <h3 class="h2">{item.name}</h3>
                <p class="body muted">{item.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--flush-top" aria-labelledby="seats-title">
    <div class="container seats">
      <div class="seats__where">
        <h2 id="seats-title" class="h1" data-reveal set:html={em(a.seats.title)} />
        <p class="body muted" data-reveal style="--i:1">{a.seats.intro}</p>
        <ul class="seats__cats" role="list" data-reveal style="--i:2">
          {a.seats.categories.map((c) => <li>{c}</li>)}
        </ul>
      </div>
      <div class="seats__criteria card" data-reveal style="--i:1">
        <h3 class="label label--ink">{a.seats.lookFor}</h3>
        <ul role="list">
          {
            a.seats.criteria.map((c) => (
              <li>
                <Icon name="check" />
                <span>{c}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <CtaPanel lang={lang} title={a.cta.title} body={a.cta.body} />
</Base>

<style>
  /* Both sides of the deal: a short vertical timeline */
  .deal {
    display: grid;
    gap: 1.25rem;
  }
  .deal__list {
    position: relative;
    display: grid;
    gap: 1.5rem;
    padding-left: 1.5rem;
  }
  .deal__list::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 0.4rem;
    bottom: 0.4rem;
    width: 1px;
    background: var(--hairline);
  }
  .deal__item {
    position: relative;
    display: grid;
    gap: 0.2rem;
  }
  .deal__item::before {
    content: '';
    position: absolute;
    left: calc(-1.5rem);
    top: 0.45rem;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--bg);
    border: 1.5px solid var(--fg);
  }
  .deal__item--now::before {
    background: var(--fg);
  }
  .deal__when {
    font-family: var(--mono);
    font-size: var(--t-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  .deal__line {
    font-family: var(--serif);
    font-size: 1.375rem;
    line-height: 1.25;
  }
  .deal__text {
    font-family: var(--sans);
    font-size: var(--t-small);
    line-height: 1.5;
    color: var(--fg-muted);
  }

  /* Areas: an asymmetric 2 x 2 */
  .areas {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gutter);
  }
  .area {
    display: grid;
    align-content: start;
    gap: 0.9rem;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    min-height: 15rem;
  }
  .area--0 {
    grid-column: 1 / span 7;
  }
  .area--1 {
    grid-column: 8 / span 5;
  }
  .area--2 {
    grid-column: 1 / span 5;
  }
  .area--3 {
    grid-column: 6 / span 7;
  }
  .area__num {
    margin-bottom: 1.5rem;
  }
  .area__text {
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--fg-muted);
    max-width: 30em;
  }

  /* Portfolio table */
  .pf {
    display: grid;
    border-top: 2px solid var(--rule);
  }
  .pf__head,
  .pf__row {
    display: grid;
    grid-template-columns: 3fr 3fr 2fr 3fr;
    gap: var(--gutter);
    align-items: baseline;
  }
  .pf__head {
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--hairline);
    font-family: var(--mono);
    font-size: var(--t-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  .pf__row {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--hairline);
  }
  .pf__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--serif);
    font-size: var(--t-h2);
    line-height: 1.2;
    color: var(--fg);
    text-decoration: none;
  }
  .pf__link :global(.icon) {
    width: 18px;
    height: 18px;
    opacity: 0.4;
    transition: transform 0.4s var(--ease-out), opacity 0.3s ease;
  }
  .pf__link:hover :global(.icon) {
    opacity: 1;
    transform: translate(3px, -3px);
  }
  .pf__link:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  .pf__cell {
    font-family: var(--sans);
    font-size: var(--t-ui);
    line-height: 1.5;
    color: var(--fg-muted);
  }
  .pf__role {
    color: var(--fg);
    font-weight: 500;
  }
  .pf__note {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.5rem;
    color: var(--fg-muted);
  }
  @media (max-width: 860px) {
    .pf__head {
      display: none;
    }
    .pf__row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .pf__cell::before {
      content: attr(data-label);
      display: block;
      font-family: var(--mono);
      font-size: var(--t-label);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--fg-muted);
      margin-top: 0.4rem;
    }
  }

  /* Formats */
  .formats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem var(--gutter);
  }
  .format {
    display: grid;
    gap: 1.25rem;
    padding-top: 1.25rem;
  }
  .format dl {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gutter);
  }
  .format dt {
    margin-bottom: 0.4rem;
  }
  .format dd {
    margin: 0;
    font-family: var(--sans);
    font-size: var(--t-ui);
    line-height: 1.5;
    color: var(--fg-muted);
  }
  @media (max-width: 760px) {
    .formats,
    .format dl {
      grid-template-columns: 1fr;
    }
    .format dl {
      gap: 1rem;
    }
  }

  /* Investors */
  .investors {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: 2.5rem var(--gutter);
    align-items: end;
    padding: clamp(1.75rem, 1rem + 4vw, 4rem);
  }
  .investors__copy {
    display: grid;
    gap: 1.1rem;
  }
  .investors__copy .body {
    color: var(--fg-muted);
  }
  .investors__list {
    display: grid;
    border-top: 2px solid var(--fg);
  }
  .investors__list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--fg) 18%, transparent);
    font-family: var(--serif);
    font-size: 1.25rem;
  }
  @media (max-width: 860px) {
    .investors {
      grid-template-columns: 1fr;
    }
  }

  /* Independence */
  .independence {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 2.5rem var(--gutter);
  }
  .independence__head {
    grid-column: 1 / span 4;
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  .independence__list {
    grid-column: 6 / span 7;
    border-top: 2px solid var(--rule);
  }
  .independence__list li {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 1rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--hairline);
  }
  .independence__list li > div {
    display: grid;
    gap: 0.5rem;
  }
  .independence__num {
    font-family: var(--serif);
    font-weight: 300;
    font-size: 2.25rem;
    line-height: 1;
    color: var(--fg-muted);
  }
  @media (max-width: 900px) {
    .independence__head,
    .independence__list {
      grid-column: 1 / -1;
    }
  }

  /* Seats */
  .seats {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 2.5rem var(--gutter);
    align-items: start;
  }
  .seats__where {
    grid-column: 1 / span 6;
    display: grid;
    gap: 1.25rem;
  }
  .seats__cats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
  .seats__cats li {
    padding: 0.55rem 0.9rem;
    font-family: var(--sans);
    font-size: var(--t-small);
    font-weight: 500;
    border: 1px solid var(--fg);
    border-radius: var(--radius);
  }
  .seats__criteria {
    grid-column: 8 / span 5;
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
  }
  .seats__criteria ul {
    display: grid;
    gap: 1rem;
  }
  .seats__criteria li {
    display: grid;
    grid-template-columns: 1.25rem 1fr;
    gap: 0.75rem;
    font-size: 1.0625rem;
    line-height: 1.5;
  }
  .seats__criteria :global(.icon) {
    width: 18px;
    height: 18px;
    margin-top: 0.25rem;
  }
  @media (max-width: 900px) {
    .area--0,
    .area--1,
    .area--2,
    .area--3,
    .seats__where,
    .seats__criteria {
      grid-column: 1 / -1;
    }
    .area {
      min-height: 0;
    }
  }
</style>
