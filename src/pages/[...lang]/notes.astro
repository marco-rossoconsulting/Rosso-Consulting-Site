---
import Base from '../../layouts/Base.astro';
import CtaPanel from '../../components/CtaPanel.astro';
import NoteList, { type NoteRow } from '../../components/NoteList.astro';
import Icon from '../../components/Icon.astro';
import { getCopy, em, langStaticPaths, type Lang } from '../../i18n';
import { getEssays, getFieldNotes, essayHref, noteHref } from '../../lib/notes';
import { smartQuotes } from '../../lib/typography';
import { site } from '../../data/site';

export const getStaticPaths = langStaticPaths;
const { lang } = Astro.props as { lang: Lang };
const t = getCopy(lang);
const n = t.notes;

const fieldNotes: NoteRow[] = (await getFieldNotes()).map((note) => ({
  href: noteHref(note.id),
  title: smartQuotes(note.data.title),
  deck: smartQuotes(note.data.summary),
  date: note.data.date,
  kicker: `${t.article.fieldNote} ${String(note.data.number).padStart(3, '0')}`,
}));
const essays: NoteRow[] = (await getEssays()).map((e) => ({
  href: essayHref(e.id),
  title: smartQuotes(e.data.title),
  deck: smartQuotes(e.data.deck),
  date: e.data.date,
  kicker: e.data.category,
  readTime: `${e.data.readTime} ${t.ui.minRead}`,
}));
const contentLang = lang === 'en' ? undefined : 'en';
---

<Base lang={lang} title={n.seo.title} description={n.seo.description} current="notes">
  <section class="page-hero" aria-labelledby="page-title">
    <div class="container page-hero__inner">
      <div class="page-hero__main">
        <p class="label fade-up" style="--i:0">{n.hero.label}</p>
        <h1 id="page-title" class="display">
          <span class="mask-line" style="--i:0"><span set:html={em(n.hero.title)} /></span>
        </h1>
        <p class="standfirst fade-up" style="--i:1">{n.hero.standfirst}</p>
        {n.langNote && <p class="small muted fade-up" style="--i:2">{n.langNote}</p>}
      </div>
      <div class="page-hero__aside follow fade-up" style="--i:3">
        <a href={site.linkedin} class="arrow-link arrow-link--out" target="_blank" rel="me noopener">
          <Icon name="linkedin-logo" />
          {n.follow}
          <span class="visually-hidden">{t.ui.newTab}</span>
        </a>
        <a href="/rss.xml" class="arrow-link"><Icon name="rss" />{n.rss}</a>
      </div>
    </div>
  </section>

  <section class="section section--flush-top" aria-labelledby="field-notes-title">
    <div class="container">
      <h2 id="field-notes-title" class="h1 notes-head" data-reveal>{n.fieldNotes.title}</h2>
      {
        fieldNotes.length ? (
          <NoteList rows={fieldNotes} lang={lang} contentLang={contentLang} size="large" />
        ) : (
          <div class="empty panel" data-reveal>
            <span class="tag">{t.status.testing}</span>
            <p class="empty__text">{n.fieldNotes.empty}</p>
            <div class="empty__actions">
              <a href={site.linkedin} class="btn" target="_blank" rel="me noopener">
                <Icon name="linkedin-logo" />
                {n.follow}
                <span class="visually-hidden">{t.ui.newTab}</span>
              </a>
              <a href="/rss.xml" class="arrow-link">
                <Icon name="rss" />
                {n.rss}
              </a>
            </div>
          </div>
        )
      }
    </div>
  </section>

  <section class="section section--flush-top" aria-labelledby="essays-title">
    <div class="container">
      <div class="notes-head">
        <h2 id="essays-title" class="h1" data-reveal>{n.essays.title}</h2>
        <p class="body muted" data-reveal style="--i:1">{n.essays.intro}</p>
      </div>
      <NoteList rows={essays} lang={lang} contentLang={contentLang} size="large" />
    </div>
  </section>

  <CtaPanel lang={lang} />
</Base>

<style>
  .follow {
    display: grid;
    justify-items: start;
    gap: 0.5rem;
  }
  .notes-head {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }
  .empty {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
    padding: clamp(1.75rem, 1rem + 3vw, 3rem);
  }
  .empty__text {
    font-family: var(--serif);
    font-weight: 300;
    font-size: var(--t-h2);
    line-height: 1.35;
    max-width: 30em;
  }
  .empty__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }
</style>
