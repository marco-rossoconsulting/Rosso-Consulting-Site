---
import Base from '../../layouts/Base.astro';
import { getCopy, em, langStaticPaths, type Lang } from '../../i18n';

export const getStaticPaths = langStaticPaths;
const { lang } = Astro.props as { lang: Lang };
const t = getCopy(lang);
const p = t.privacy;
---

<Base lang={lang} title={p.seo.title} description={p.seo.description} current="privacy">
  <section class="page-hero" aria-labelledby="page-title">
    <div class="container page-hero__inner">
      <div class="page-hero__main">
        <h1 id="page-title" class="display">
          <span class="mask-line" style="--i:0"><span set:html={em(p.title)} /></span>
        </h1>
        <p class="label label--quiet fade-up" style="--i:1">{p.updated}</p>
      </div>
    </div>
  </section>
  <section class="section section--flush-top">
    <div class="container">
      <div class="policy">
        {
          p.sections.map((s) => (
            <section class="policy__item">
              <h2 class="h2">{s.h}</h2>
              <p class="body">{s.p}</p>
            </section>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .policy {
    max-width: 44rem;
    border-top: 2px solid var(--rule);
  }
  .policy__item {
    display: grid;
    gap: 0.6rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--hairline);
  }
</style>
