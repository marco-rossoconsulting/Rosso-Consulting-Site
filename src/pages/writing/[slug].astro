---
import { render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { getEssays, essayHref } from '../../lib/notes';
import { smartQuotes } from '../../lib/typography';
import { getCopy, path } from '../../i18n';

export async function getStaticPaths() {
  const essays = await getEssays();
  return essays.map((essay) => ({ params: { slug: essay.id }, props: { essay, all: essays } }));
}

const { essay, all } = Astro.props;
const { Content } = await render(essay);
const t = getCopy('en');
const wordCount = (essay.body ?? '').split(/\s+/).filter(Boolean).length;

const relatedIds = essay.data.related?.map((r) => r.id) ?? [];
const relatedEntries = (relatedIds.length ? all.filter((e) => relatedIds.includes(e.id)) : all.filter((e) => e.id !== essay.id)).slice(0, 2);
const related = relatedEntries.map((e) => ({
  href: essayHref(e.id),
  title: smartQuotes(e.data.title),
  deck: smartQuotes(e.data.deck),
  date: e.data.date,
  kicker: e.data.category,
  readTime: `${e.data.readTime} ${t.ui.minRead}`,
}));

// Related service: a contextual link to the service page this essay leads to.
const serviceKey = essay.data.service;
const service = serviceKey
  ? {
      href: path('en', serviceKey),
      title: t[serviceKey].seo.title.replace(/\s*·\s*Rosso Consulting$/, ''),
      text: t[serviceKey].seo.description,
    }
  : undefined;
---

<Article
  title={essay.data.title}
  deck={essay.data.deck}
  date={essay.data.date}
  updated={essay.data.updated}
  kicker={`${t.article.essay} · ${essay.data.category}`}
  readTime={essay.data.readTime}
  seoTitle={essay.data.seo?.title}
  seoDescription={essay.data.seo?.description}
  image={essay.data.seo?.image}
  imageAlt={essay.data.seo?.imageAlt}
  related={related}
  relatedTitle={t.article.relatedNotes}
  service={service}
  section={essay.data.category}
  wordCount={wordCount}
>
  <Content />
</Article>
